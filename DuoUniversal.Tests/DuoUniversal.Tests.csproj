<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0</TargetFrameworks>
    <!-- Also test the SDK's net471 build on .NET Framework, which can only run on Windows -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net6.0;net48</TargetFrameworks>
    <!-- Pin the net6.0 default so the tests compile the same way for .NET Framework -->
    <LangVersion>10.0</LangVersion>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JWT" Version="8.2.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.9.4" />
    <PackageReference Include="NUnit" Version="3.13.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="3.17.0" />
    <PackageReference Include="coverlet.collector" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Web" />
  </ItemGroup>

  <!-- Consumers often resolve a newer IdentityModel than the SDK's minimum through other
       dependencies (e.g. ASP.NET Core auth). Test against one with
       dotnet test -p:JsonWebTokensVersion=8.23.0 -->
  <ItemGroup Condition="'$(JsonWebTokensVersion)' != ''">
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="$(JsonWebTokensVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuoUniversal\DuoUniversal.csproj" />
  </ItemGroup>

</Project>
